# Postgres (Neon / Supabase / Vercel Postgres). If unset, a local embedded DB is used in ./.data (dev only).
DATABASE_URL=
# Bootstrap: emails allowed in before any member has an email on file (the first admins). After that, access = Members tab.
ALLOWED_EMAILS=you@berkeley.edu
# Google OAuth (console.cloud.google.com > Credentials). Redirect: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Admin password: unlocks add/edit/delete/promote and /admin. Required in production.
ADMIN_PASSWORD=

# JSON API for agents/scripts (see AGENTS.md): send `Authorization: Bearer <ADMIN_PASSWORD>` to /api/records,
# /api/export/<type> and /api/import/<type>. The bearer token = ADMIN_PASSWORD and grants full read/write;
# without it, reads need a member session and writes get 401. Locally (ADMIN_PASSWORD unset) the token is `admin`.
# Local embedded DB directory (PGlite), used when DATABASE_URL is unset. Default ./.data/pg. Also read by `npm run seed:load`.
LOCAL_DB_DIR=
