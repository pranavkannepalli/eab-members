# Postgres (Neon / Supabase / Vercel Postgres). If unset, a local embedded DB is used in ./.data (dev only).
DATABASE_URL=
# Member sign-in: any verified Google account on this domain (default berkeley.edu). Set to empty to allow only ALLOWED_EMAILS.
ALLOWED_DOMAIN=berkeley.edu
# Extra emails allowed regardless of domain (comma-separated), e.g. alumni.
ALLOWED_EMAILS=
# Google OAuth (console.cloud.google.com > Credentials). Redirect: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Admin password: unlocks add/edit/delete/promote and /admin. Required in production.
ADMIN_PASSWORD=
